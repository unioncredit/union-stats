# Ponder indexer serving member/chart data (Base + Optimism). Defaults to the
# production Railway deployment when unset.
REACT_APP_PONDER_URL=

# Alchemy keys are optional: when a key is missing the app reads through the
# chain's public fallback RPCs (PublicNode, and mainnet.base.org on Base).
REACT_APP_MAINNET_ALCHEMY_KEY=
REACT_APP_ARBITRUM_ALCHEMY_KEY=
REACT_APP_BASE_ALCHEMY_KEY=
REACT_APP_OPTIMISM_ALCHEMY_KEY=
